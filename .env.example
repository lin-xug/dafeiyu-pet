# 复制成 .env 再改。真实环境变量优先于这个文件。

# ---- 模型接口（任何 OpenAI 兼容端点都行）----
# DeepSeek 官方
API_BASE=https://api.deepseek.com/v1
API_KEY=sk-your-key-here
MODEL=deepseek-chat
# 模型调不通时回一句短话
LLM_FALLBACK_ENABLED=1
LLM_FALLBACK_COOLDOWN=120
MAX_TOKENS=90
TEMPERATURE=1.05

# 想用之前那个超算端点就换成：
# API_BASE=https://maas.nscc-cs.cn/external/api/v1
# MODEL=Qwen3.5

# ---- NapCat / OneBot ----
ONEBOT_URL=http://127.0.0.1:3000
# NapCat「HTTP 服务器」里设的 token，没设就留空
ONEBOT_TOKEN=

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000

# ---- 调试开关 ----
# 1 = 不真发 QQ，只写日志
DRY_RUN=0
# 1 = 不调模型，返回假回复（测链路用）
MOCK_LLM=0

# ---- 拟人化 ----
# 打错字再撤回的概率（0 关闭）
TYPO_CHANCE=0.10
# 兜底发表情的概率
STICKER_CHANCE=0.60
STICKER_COOLDOWN=90

# ---- 群聊 ----
# 只在这些群里说话，逗号分隔；留空 = 所有群
GROUPS=
GROUP_THRESHOLD=0.70
GROUP_HOURLY_LIMIT=2
GROUP_DAILY_LIMIT=15
GROUP_RANDOM_CHANCE=0.03

# ---- 好感度 ----
AFFINITY_ENABLED=1
# 多久不说话算冷落
AFFINITY_DECAY_HOURS=720
AFFINITY_DECAY_PENALTY=10

# ---- 记忆 ----
# 记忆存哪，默认 ~/文档/大肥鱼
DATA_DIR=
HISTORY_TURNS=12
# 长期摘要
SUMMARY_ENABLED=1
# 原话攒到多少条压缩一次
SUMMARY_TRIGGER=32
# 压缩后保留多少条原话
SUMMARY_KEEP=16

# ---- 语音（可选，需要 DASHSCOPE_API_KEY）----
VOICE_ENABLED=0
VOICE_CHANCE=0
VOICE_MODEL=cosyvoice-v3-flash
VOICE_NAME=longxian_v3
VOICE_INSTRUCT=
VOICE_RATE=1.05
VOICE_PITCH=0.94
VOICE_CMD_USERS=
VOICE_CMD_MAX_CHARS=120
VOICE_MAX_CHARS=40

# ---- 账单 / 用量 ----
# 谁能查余额和用量（逗号分隔的 QQ）；留空 = 谁都查不了
ADMIN_USERS=
# CosyVoice 单价：元/万字符。v3.5-flash 是 0.8，v3-flash 是 1.0
VOICE_PRICE=0.8
# 阿里云 AccessKey：**只用来查账户余额**，DashScope 的 sk- key 查不了账单。
# 不填也能用，只是"余额"里阿里云那行会显示"查不了"。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# ---- 计费单价（元/百万 token，仅用于估算，不是账单）----
# 命中上下文缓存比未命中便宜很多，分开配才不会高估
PRICE_CACHE_HIT=0.5
PRICE_INPUT=2
PRICE_OUTPUT=8

# 有人冒充"她认识的人"时扣分（逗号分隔，要写完整句子片段）；留空 = 不判断
IMPERSONATE_WORDS=
# 超活跃模式的随机率 / 被点名回复率
HYPER_RANDOM=0.35
GROUP_MENTION_RATE=1.0
# 「突然想说话」加的分，要能单独把普通消息顶过阈值
GROUP_RANDOM_BONUS=0.75
